[
  {
    "id": "wish-1-task-tracker",
    "prompt": "A task tracker with users, tasks, and due dates",
    "prd": {
      "appName": "TaskOrb",
      "tagline": "Track tasks across the cosmos",
      "tables": [
        {"name": "users", "fields": [{"name": "email", "type": "text"}, {"name": "created_at", "type": "timestamp"}]},
        {"name": "tasks", "fields": [{"name": "title", "type": "text"}, {"name": "due_date", "type": "timestamp"}, {"name": "completed", "type": "boolean"}]}
      ],
      "pages": [
        {"name": "Dashboard", "route": "/", "components": ["TaskList", "TaskCard"]},
        {"name": "TaskDetail", "route": "/tasks/:id", "components": ["TaskForm"]}
      ],
      "apis": [
        {"method": "GET", "path": "/api/tasks", "desc": "list tasks"},
        {"method": "POST", "path": "/api/tasks", "desc": "create task"},
        {"method": "GET", "path": "/api/users", "desc": "list users"},
        {"method": "PATCH", "path": "/api/tasks/:id", "desc": "update task"}
      ],
      "auth": true
    },
    "artifacts": {
      "schema": {
        "tables": [
          {"name": "users", "fields": [{"name": "email", "type": "text"}, {"name": "created_at", "type": "timestamp"}]},
          {"name": "tasks", "fields": [{"name": "title", "type": "text"}, {"name": "due_date", "type": "timestamp"}, {"name": "completed", "type": "boolean"}]}
        ],
        "prisma": "model User {\n  id String @id @default(uuid())\n  email String @unique\n  createdAt DateTime @default(now())\n}\n\nmodel Task {\n  id String @id @default(uuid())\n  title String\n  dueDate DateTime?\n  completed Boolean @default(false)\n  userId String\n}",
        "sql": "create table users (id uuid primary key default gen_random_uuid(), email text not null, created_at timestamptz default now());\ncreate table tasks (id uuid primary key default gen_random_uuid(), title text not null, due_date timestamptz, completed boolean default false);"
      },
      "frontend": {
        "files": [
          {"path": "src/pages/Dashboard.tsx", "content": "export default function Dashboard(){ return <div>Dashboard — Intara TaskOrb</div> }"},
          {"path": "src/components/TaskCard.tsx", "content": "export function TaskCard({title}:{title:string}){ return <div>{title}</div> }"},
          {"path": "src/api.ts", "content": "export const api = { listTasks: () => fetch('/api/tasks') }"}
        ]
      },
      "backend": {
        "files": [
          {"path": "server/main.py", "content": "from fastapi import FastAPI\napp = FastAPI()\n@app.get(\"/health\")\ndef health(): return {\"ok\": True}\n"},
          {"path": "server/models.py", "content": "from pydantic import BaseModel\nclass Task(BaseModel):\n    title: str\n    completed: bool = False\n"}
        ],
        "requirements": "fastapi==0.110.1\nuvicorn==0.29.0\npydantic>=2.9.0\n"
      },
      "spec": {
        "readme": "# TaskOrb\nRun: npm install && npm run dev\nBackend: uvicorn main:app --reload\nIntara weaves stardust into schema.",
        "openapi": {"openapi": "3.0.0", "paths": {"/api/tasks": {"get": {"summary": "list tasks"}}, "/api/users": {"get": {"summary": "list users"}}}},
        "cites": ["DhiWise builds Rocket.new — one prompt → full app"]
      }
    }
  },
