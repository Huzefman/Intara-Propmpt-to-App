{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": "."
  },
  "include": ["engine/**/*.ts", "adapters/**/*.ts", "shell/**/*.ts", "shell/**/*.tsx", "blocks/**/*.ts", "blocks/**/*.tsx", "testing/**/*.ts", "automation/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules"]
}
