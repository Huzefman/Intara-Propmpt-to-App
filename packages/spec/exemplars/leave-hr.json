{"spec_version": "1.0", "app": {"name": "TimeOff", "tagline": "Leave requests without the email chain", "domain": "hr_leave", "locale": "en", "currency": "USD", "timezone": "UTC"}, "personas": [{"id": "staff", "name": "Employee", "goals": ["request leave fast", "see my balance"]}, {"id": "manager", "name": "Manager", "goals": ["approve in one click", "no clashes"]}], "requirements": [{"id": "R1", "text": "Staff request leave with dates and reason", "priority": "must", "persona": "staff"}, {"id": "R2", "text": "Managers approve or reject", "priority": "must", "persona": "manager"}, {"id": "R3", "text": "Balances stay visible", "priority": "should", "persona": "staff"}], "assumptions": ["Single office, annual allowance 20 days"], "model": {"enums": [{"id": "leave_status", "values": [{"value": "requested", "label": "Requested", "color": "amber"}, {"value": "approved", "label": "Approved", "color": "green"}, {"value": "rejected", "label": "Rejected", "color": "red"}, {"value": "taken", "label": "Taken", "color": "blue"}]}], "entities": [{"id": "employee", "label": "Employee", "plural": "Employees", "icon": "user", "fields": [{"id": "name", "type": "text", "required": true, "unique": true}, {"id": "allowance", "type": "int", "default": 20}, {"id": "used", "type": "int", "default": 0}], "display": {"title": "{name}"}}, {"id": "leave_request", "label": "Leave request", "plural": "Leave requests", "icon": "calendar", "fields": [{"id": "employee", "type": "ref", "target": "employee", "required": true, "onDelete": "cascade", "relation_name": "requests"}, {"id": "from_date", "type": "date", "required": true}, {"id": "to_date", "type": "date", "required": true}, {"id": "reason", "type": "text"}, {"id": "status", "type": "enum", "enum": "leave_status", "default": "requested", "index": true}], "display": {"title": "{from_date}", "subtitle": "{employee.name}"}, "lifecycle": {"field": "status", "initial": "requested", "transitions": [{"id": "approve", "from": "requested", "to": "ap