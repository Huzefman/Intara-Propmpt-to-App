{"spec_version": "1.0", "app": {"name": "FixIt", "tagline": "Track every repair from drop-off to pickup", "domain": "repair_shop", "locale": "en-IN", "currency": "INR", "timezone": "Asia/Kolkata"}, "personas": [{"id": "owner", "name": "Shop owner", "goals": ["see what is stuck", "know monthly revenue"]}, {"id": "technician", "name": "Technician", "goals": ["see my assigned jobs", "log parts used"]}], "requirements": [{"id": "R1", "text": "Register a customer's device with the reported problem", "priority": "must", "persona": "owner"}, {"id": "R2", "text": "Move each job through diagnosing, waiting for parts, ready, delivered", "priority": "must", "persona": "technician"}, {"id": "R3", "text": "Notify the customer when the job is ready", "priority": "must", "persona": "owner"}, {"id": "R4", "text": "Compute the bill from labour plus parts", "priority": "must", "persona": "owner"}, {"id": "R5", "text": "See jobs in progress, ready for pickup, and revenue this month", "priority": "should", "persona": "owner"}], "assumptions": ["Single shop, no online payments", "Customers are notified by email when available"], "model": {"enums": [{"id": "job_status", "values": [{"value": "received", "label": "Received", "color": "slate"}, {"value": "diagnosing", "label": "Diagnosing", "color": "amber"}, {"value": "waiting_parts", "label": "Waiting for parts", "color": "orange"}, {"value": "ready", "label": "Ready", "color": "green"}, {"value": "delivered", "label": "Delivered", "color": "blue"}]}], "entities": [{"id": "customer", "label": "Customer", "plural": "Customers", "icon": "user", "fields": [{"id": "name", "type": "text", "required": true}, {"id": "phone", "type": "phone", "required": true, "unique": true}, {"id": "email", "type": "email"}], "display": {"title": "{name}", "subtitle": "{phone}"}}, {"id": "job", "label": "Job", "plural": "Jobs", "icon": "wrench", "fields": [{"id": "customer", "type": "ref", "target": "customer", "required": true, "onDelete": "restrict"}, {"id": "device", "type": "text", "required": true}, {"id": "problem", "type": "longtext", "required": true}, {"id": "status", "type": "enum", "enum": "job_status", "default": "received", "index": true}, {"id": "technician", "type": "text"}, {"id": "labour_cost", "type": "money", "default": 0}, {"id": "parts_total", "type": "money", "computed": {"formula": "sum(parts.line_total)"}}, {"id": "total", "type": "money", "computed": {"formula": "labour_cost + parts_total"}}, {"id": "received_at", "type": "datetime", "default": "now()"}], "display": {"title": "{device}", "subtitle": "{customer.name}"}, "lifecycle": {"field": "status", "initial": "received", "transitions": [{"id": "start", "from": "received", "to": "diagnosing", "label": "Start diagnosis", "roles": ["technician", "owner"]}, {"id": "need_parts", "from": "diagnosing", "to": "waiting_parts", "label": "Need parts", "roles": ["technician", "owner"]}, {"id": "parts_in", "from": "waiting_parts", "to": "diagnosing", "label": "Parts arrived", "roles": ["technician", "owner"]}, {"id": "finish", "from": "diagnosing", "to": "ready", "label": "Mark ready", "roles": ["technician", "owner"]}, {"id": "handover", "from": "ready", "to": "delivered", "label": "Hand over", "roles": ["owner"]}]}}, {"id": "part", "label": "Part used", "plural": "Parts used", "icon": "cog", "fields": [{"id": "job", "type": "ref", "target": "job", "required": true, "onDelete": "cascade", "relation_name": "parts"}, {"id": "name", "type": "text", "required": true}, {"id": "qty", "type": "int", "required": true, "default": 1}, {"id": "unit_price", "type": "money", "required": true}, {"id": "line_total", "type": "money", "computed": {"formula": "qty * unit_price"}}]}]}, "access": {"roles": [{"id": "owner", "label": "Owner"}, {"id": "technician", "label": "Technician"}], "rules": [{"entity": "*", "role": "owner", "ops": ["read", "create", "update", "delete"]}, {"entity": "job", "role": "technician", "ops": ["read", "update"], "where": "technician == $user.name"}, {"entity": "part", "role": "technician", "ops": ["read", "create", "update"]}, {"entity": "customer", "role": "technician", "ops": ["read"]}]}, "ui": {"theme": {"archetype": "pipeline-board", "palette": "teal", "density": "compact", "radius": "md", "fonts": "inter"}, "nav": [{"page": "board", "label": "Board", "icon": "columns"}, {"page": "jobs", "label": "All jobs", "icon": "list"}, {"page": "customers", "label": "Customers", "icon": "users", "roles": ["owner"]}], "pages": [{"id": "board", "route": "/", "title": "Repair board", "roles": ["owner", "technician"], "layout": "layout.sidebar", "blocks": [{"id": "b_stats", "type": "metric.stat", "props": {"entity": "job", "items": [{"label": "In progress", "agg": "count", "where": "status != 'delivered'"}, {"label": "Ready for pickup", "agg": "count", "where": "status == 'ready'"}, {"label": "Revenue this month", "agg": "sum", "field": "total", "where": "status == 'delivered'"}]}}, {"id": "b_board", "type": "data.kanban", "props": {"entity": "job", "group_by": "status", "card": {"title": "device", "subtitle": "customer.name", "badges": ["technician"]}, "drag_transitions": true}}]}, {"id": "jobs", "route": "/jobs", "title": "All jobs", "roles": ["owner", "technician"], "layout": "layout.sidebar", "blocks": [{"id": "b_filter", "type": "filter.bar", "props": {"entity": "job", "fields": ["status", "technician"], "search": ["device"]}}, {"id": "b_table", "type": "data.table", "props": {"entity": "job", "columns": ["device", "customer.name", "status", "total", "received_at"], "row_link": "job_detail", "create": true}}]}, {"id": "job_detail", "route": "/jobs/:id", "title": "Job", "roles": ["owner", "technician"], "layout": "layout.sidebar", "blocks": [{"id": "b_pipe", "type": "lifecycle.pipeline", "props": {"entity": "job"}}, {"id": "b_detail", "type": "record.detail", "props": {"entity": "job", "sections": [{"title": "Device", "fields": ["device", "problem", "customer"]}, {"title": "Billing", "fields": ["labour_cost", "parts_total", "total"]}]}}, {"id": "b_parts", "type": "record.related_list", "props": {"entity": "part", "via": "job", "create": true, "columns": ["name", "qty", "unit_price", "line_total"]}}]}, {"id": "customers", "route": "/customers", "title": "Customers", "roles": ["owner"], "layout": "layout.sidebar", "blocks": [{"id": "b_cust", "type": "data.table", "props": {"entity": "customer", "columns": ["name", "phone", "email"], "create": true}}]}]}, "automations": [{"id": "notify_ready", "trigger": {"type": "lifecycle.transition", "entity": "job", "transition": "finish"}, "steps": [{"action": "send_email", "when": "customer.email != null", "params": {"to": "customer.email", "subject": "Your device is ready"}}, {"action": "notify", "params": {"role": "owner", "message": "A job is ready"}}]}], "seed": {"customer": [{"_key": "c1", "name": "Anita Shah", "phone": "+91 98250 11111", "email": "anita@example.com"}, {"_key": "c2", "name": "Rohan Patel", "phone": "+91 98250 22222"}], "job": [{"_key": "j1", "customer": "@c1", "device": "Samsung A52", "problem": "Cracked screen", "status": "diagnosing", "technician": "Imran", "labour_cost": 300}, {"_key": "j2", "customer": "@c2", "device": "Dell Inspiron 15", "problem": "Won't boot", "status": "waiting_parts", "technician": "Imran", "labour_cost": 500}], "part": [{"job": "@j2", "name": "SSD 256GB", "qty": 1, "unit_price": 2200}]}, "integrations": [{"type": "email", "provider": "resend"}], "trace": [{"requirement": "R1", "satisfied_by": ["entity:customer", "entity:job", "page:jobs"]}, {"requirement": "R2", "satisfied_by": ["entity:job", "page:board"]}, {"requirement": "R3", "satisfied_by": ["automation:notify_ready"]}, {"requirement": "R4", "satisfied_by": ["entity:job", "entity:part"]}, {"requirement": "R5", "satisfied_by": ["page:board"]}]}