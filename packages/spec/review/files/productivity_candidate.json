{
  "ui": {
    "nav": [
      {
        "icon": "layout-dashboard",
        "page": "dashboard",
        "label": "Dashboard",
        "roles": [
          "owner",
          "member"
        ]
      },
      {
        "icon": "columns",
        "page": "board",
        "label": "Board",
        "roles": [
          "owner",
          "member"
        ]
      },
      {
        "icon": "check-square",
        "page": "tasks",
        "label": "Tasks",
        "roles": [
          "owner",
          "member"
        ]
      },
      {
        "icon": "folder",
        "page": "projects",
        "label": "Projects",
        "roles": [
          "owner",
          "member"
        ]
      }
    ],
    "pages": [
      {
        "id": "dashboard",
        "roles": [
          "owner",
          "member"
        ],
        "route": "/",
        "title": "Dashboard",
        "blocks": [
          {
            "id": "task_stats",
            "type": "metric.stat",
            "props": {
              "entity": "task",
              "items": [
                {
                  "label": "Open tasks",
                  "agg": "count",
                  "where": "status != 'done'"
                },
                {
                  "label": "Overdue",
                  "agg": "count",
                  "where": "status != 'done' and due_date < today()"
                },
                {
                  "label": "In review",
                  "agg": "count",
                  "where": "status == 'in_review'"
                }
              ]
            }
          },
          {
            "id": "hours_stats",
            "type": "metric.stat",
            "props": {
              "entity": "time_entry",
              "items": [
                {
                  "label": "Hours this month",
                  "agg": "sum",
                  "field": "hours",
                  "where": "logged_on >= startOfMonth()"
                }
              ]
            }
          },
          {
            "id": "tasks_by_status",
            "type": "chart.bar",
            "props": {
              "entity": "task",
              "title": "Tasks by Status",
              "x": "status",
              "y": "count"
            }
          },
          {
            "id": "due_timeline",
            "type": "activity.timeline",
            "props": {
              "entity": "task",
              "date_field": "due_date",
              "title": "Upcoming deadlines"
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "board",
        "roles": [
          "owner",
          "member"
        ],
        "route": "/board",
        "title": "Board",
        "blocks": [
          {
            "id": "board_filter",
            "type": "filter.bar",
            "props": {
              "entity": "task",
              "fields": [
                "priority",
                "project"
              ],
              "search": [
                "title"
              ]
            }
          },
          {
            "id": "task_board",
            "type": "data.kanban",
            "props": {
              "entity": "task",
              "group_by": "status",
              "card": {
                "title": "title",
                "subtitle": "project.name",
                "badges": [
                  "priority"
                ]
              },
              "drag_transitions": true
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "tasks",
        "roles": [
          "owner",
          "member"
        ],
        "route": "/tasks",
        "title": "Tasks",
        "blocks": [
          {
            "id": "task_filter",
            "type": "filter.bar",
            "props": {
              "entity": "task",
              "fields": [
                "status",
                "priority",
                "project"
              ],
              "search": [
                "title",
                "assignee_email"
              ]
            }
          },
          {
            "id": "task_calendar",
            "type": "calendar.month",
            "props": {
              "entity": "task",
              "date_field": "due_date",
              "row_link": "task_detail"
            }
          },
          {
            "id": "task_table",
            "type": "data.table",
            "props": {
              "entity": "task",
              "columns": [
                "title",
                "project.name",
                "assignee_email",
                "priority",
                "due_date",
                "status",
                "hours_remaining"
              ],
              "row_link": "task_detail",
              "create": true
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "task_detail",
        "roles": [
          "owner",
          "member"
        ],
        "route": "/tasks/:id",
        "title": "Task",
        "blocks": [
          {
            "id": "task_lifecycle",
            "type": "lifecycle.pipeline",
            "props": {
              "entity": "task"
            }
          },
          {
            "id": "task_info",
            "type": "record.detail",
            "props": {
              "entity": "task",
              "sections": [
                {
                  "title": "Task",
                  "fields": [
                    "title",
                    "project",
                    "description",
                    "status",
                    "priority"
                  ]
                },
                {
                  "title": "Planning",
                  "fields": [
                    "assignee_email",
                    "due_date",
                    "estimate_hours"
                  ]
                },
                {
                  "title": "Time",
                  "fields": [
                    "hours_logged",
                    "hours_remaining"
                  ]
                }
              ]
            }
          },
          {
            "id": "task_time",
            "type": "record.related_list",
            "props": {
              "entity": "time_entry",
              "via": "task",
              "columns": [
                "logged_on",
                "member_email",
                "hours",
                "note"
              ],
              "create": true
            }
          },
          {
            "id": "task_comments",
            "type": "record.related_list",
            "props": {
              "entity": "comment",
              "via": "task",
              "columns": [
                "author_email",
                "body"
              ],
              "create": true
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "projects",
        "roles": [
          "owner",
          "member"
        ],
        "route": "/projects",
        "title": "Projects",
        "blocks": [
          {
            "id": "project_filter",
            "type": "filter.bar",
            "props": {
              "entity": "project",
              "fields": [
                "status"
              ],
              "search": [
                "name"
              ]
            }
          },
          {
            "id": "project_table",
            "type": "data.table",
            "props": {
              "entity": "project",
              "columns": [
                "name",
                "owner_email",
                "due_date",
                "status"
              ],
              "row_link": "project_detail",
              "create": true
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "project_detail",
        "roles": [
          "owner",
          "member"
        ],
        "route": "/projects/:id",
        "title": "Project",
        "blocks": [
          {
            "id": "project_lifecycle",
            "type": "lifecycle.pipeline",
            "props": {
              "entity": "project"
            }
          },
          {
            "id": "project_info",
            "type": "record.detail",
            "props": {
              "entity": "project",
              "sections": [
                {
                  "title": "About",
                  "fields": [
                    "name",
                    "description",
                    "color",
                    "status"
                  ]
                },
                {
                  "title": "Ownership",
                  "fields": [
                    "owner_email",
                    "due_date"
                  ]
                }
              ]
            }
          },
          {
            "id": "project_tasks",
            "type": "record.related_list",
            "props": {
              "entity": "task",
              "via": "project",
              "columns": [
                "title",
                "assignee_email",
                "priority",
                "due_date",
                "status"
              ],
              "row_link": "task_detail",
              "create": true
            }
          }
        ],
        "layout": "grid"
      }
    ],
    "theme": {
      "fonts": "Inter",
      "radius": "md",
      "density": "compact",
      "palette": "blue",
      "archetype": "pipeline-board"
    }
  },
