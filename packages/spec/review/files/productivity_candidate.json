  "personas": [
    {
      "id": "project_owner",
      "name": "Project owner",
      "goals": [
        "See what is overdue or waiting for review",
        "Approve finished work"
      ]
    },
    {
      "id": "team_member",
      "name": "Team member",
      "goals": [
        "Know what is assigned to me and when it is due",
        "Log my hours and discuss tasks"
      ]
    }
  ],
  "assumptions": [
    "Small team sharing one workspace",
    "Flat task list per project (no subtasks or dependencies)",
    "People sign in with the email address stored on assignments, comments and time entries",
    "Hours are logged in decimal hours against tasks, not against projects",
    "Estimates are optional; hours remaining is blank without one",
    "Email notifications only; no chat or push",
    "No billing, invoicing or client portal",
    "Web app only (responsive); English only",
    "Single-tenant application"
  ],
  "automations": [
    {
      "id": "task_assigned_email",
      "steps": [
        {
          "when": "assignee_email != null",
          "action": "send_email",
          "params": {
            "to": "assignee_email",
            "subject": "You have a new task: {title}",
            "body": "{title} in {project.name} is assigned to you. Due: {due_date}. Priority: {priority}."
          }
        }
      ],
      "trigger": {
        "type": "record.created",
        "entity": "task",
        "schedule": null,
        "transition": null
      }
    },
    {
      "id": "review_requested_email",
      "steps": [
        {
          "when": null,
          "action": "send_email",
          "params": {
            "to": "project.owner_email",
            "subject": "Ready for review: {title}",
            "body": "{assignee_email} submitted {title} ({project.name}) for review."
          }
        }
      ],
      "trigger": {
        "type": "lifecycle.transition",
        "entity": "task",
        "schedule": null,
        "transition": "submit_review"
      }
    },
    {
      "id": "task_approved_email",
      "steps": [
        {
          "when": "assignee_email != null",
          "action": "send_email",
          "params": {
            "to": "assignee_email",
            "subject": "Approved: {title}",
            "body": "{title} was approved and is now done.\nHours logged: {hours_logged}."
          }
        }
      ],
      "trigger": {
        "type": "lifecycle.transition",
        "entity": "task",
        "schedule": null,
        "transition": "approve"
      }
    },
    {
      "id": "overdue_digest",
      "steps": [
        {
          "when": "status != 'done' and due_date < today() and assignee_email != null",
          "action": "send_email",
          "params": {
            "to": "assignee_email",
            "subject": "Overdue: {title}",
            "body": "{title} in {project.name} was due on {due_date} and is not done yet."
          }
        }
      ],
      "trigger": {
        "type": "schedule",
        "entity": "task",
        "schedule": "0 8 * * 1-5",
        "transition": null
      }
    }
  ],
  "integrations": [],
  "requirements": [
    {
      "id": "R1",
      "text": "Manage projects with an owner, due date and status (active, on hold, completed)",
      "priority": "must"
    },
    {
      "id": "R2",
      "text": "Create tasks in a project with assignee, priority, due date and an hours estimate",
      "priority": "must"
    },
    {
      "id": "R3",
      "text": "Move tasks through to do, in progress, in review and done, where only project owners can approve or reopen",
      "priority": "must"
    },
    {
      "id": "R4",
      "text": "Log hours against tasks and show hours logged and hours remaining automatically",
      "priority": "must"
    },
    {
      "id": "R5",
      "text": "Discuss each task with comments",
      "priority": "should"
    },
    {
      "id": "R6",
      "text": "Email assignees when a task is assigned, approved or overdue, and email the project owner when a task is ready for review",
      "priority": "should"
    },
    {
      "id": "R7",
      "text": "Show a dashboard, a kanban board and a due-date calendar of tasks",
      "priority": "should"
    },
    {
      "id": "R8",
      "text": "Members edit only tasks assigned to them and only their own comments and time entries",
      "priority": "must"
    }
  ],
  "spec_version": "1.0"
}
