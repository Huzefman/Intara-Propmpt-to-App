DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=gsk_your-groq-key
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY=nvapi-your-nvidia-key
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
# for Kimi K3 vision+reasoning: moonshotai/kimi-k3 (slower, 60s timeout, supports image_url + reasoning_effort=max)
GEMINI_API_KEY=your_gemini_key
SUPABASE_URL=https://your-project.supabase.co
# Server-only service_role key (bypasses RLS — never ship to the browser).
SUPABASE_SERVICE_KEY=your-service-role-key
# Public anon/publishable key — used for RAG/health reads.
SUPABASE_KEY=your-anon-key
# Account auth (default on). 0 = local MEM-only tests; never in production.
AUTH_REQUIRED=1
# Builds per account per UTC day on the SHARED LLM pool. Accounts with a saved
# BYOK key skip this limit and build on their own provider key.
DAILY_BUILD_LIMIT=3
# Encrypts per-account LLM keys (BYOK) before they are stored in Supabase.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, the server derives a key from SUPABASE_SERVICE_KEY — rotating that
# key would make every saved user key unreadable, so set this in production.
KEY_ENCRYPTION_SECRET=
# Optional defaults for BYOK providers with no app-side default model.
# BYOK_OPENAI_MODEL=gpt-4o-mini
# BYOK_ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=sk-or-your-openrouter-key
# Verified working free ids (2026-10; re-check https://openrouter.ai/models — ids rotate):
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK=google/gemma-4-26b-a4b-it:free
OPENROUTER_EMBED_MODEL=
# Leave empty for demo — uses mock planner + MEM store + deterministic generators + fallback cites (still passes benchmark)
# Chain: Gemini (primary) → OpenRouter → Groq → Nvidia → DeepSeek, 60s cooldown per provider (LLM_COOLDOWN_SECONDS), auto-reuse on refresh, mock+warning when all exhausted
# Get free keys: Groq https://console.groq.com/keys , OpenRouter https://openrouter.ai/keys (both free, no card for :free)
# LLM_COOLDOWN_SECONDS=60
# LLM_ONLY=gemini  # constrain the chain to one provider (or comma list: gemini,groq). Empty = all configured.
# Phase 2 — gateway telemetry + cassettes (migration 006a_llm_calls.sql must be applied first)
# LLM_TELEMETRY=1  # 0 disables llm_calls recording
# LLM_CASSETTES=off  # off | record | replay (offline eval fixtures under evals/cassettes)
# LLM_CASSETTE_DIR=evals/cassettes
# Phase 3 — durable builds (migration 006b_artifact_contents.sql must be applied first)
# ARTIFACT_MAX_BYTES=20000000  # refuse absurdly large step contents (fail-fast, never persist hollow)
