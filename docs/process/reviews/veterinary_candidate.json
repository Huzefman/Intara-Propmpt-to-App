  "personas": [
    {
      "id": "clinic_admin",
      "name": "Clinic admin",
      "goals": [
        "Keep owner and pet records accurate",
        "Know today's schedule and monthly revenue"
      ]
    },
    {
      "id": "vet",
      "name": "Veterinarian",
      "goals": [
        "See who is booked today",
        "Record notes and treatments quickly"
      ]
    },
    {
      "id": "pet_owner",
      "name": "Pet owner",
      "goals": [
        "Book and cancel visits",
        "See my pets' visit history and bills"
      ]
    }
  ],
  "assumptions": [
    "Single clinic location",
    "Patients are cats and dogs only",
    "Visits are not assigned to a specific veterinarian",
    "Appointment-based visits only (no walk-ins)",
    "One owner can have several pets",
    "Treatments are free-text line items with a price; there is no medicine stock tracking",
    "A visit shows its total, but there is no GST invoicing or online payment",
    "Pet owners sign in with the same email address stored on their owner record",
    "Currency is INR; Indian phone numbers and addresses",
    "Single-tenant application"
  ],
  "automations": [
    {
      "id": "visit_booked_confirmation",
      "steps": [
        {
          "when": null,
          "action": "send_email",
          "params": {
            "to": "patient.owner.email",
            "subject": "Visit booked for {patient.name}",
            "body": "Hi {patient.owner.full_name}, {patient.name}'s visit is booked for {visit_date}. Reason: {reason}."
          }
        }
      ],
      "trigger": {
        "type": "record.created",
        "entity": "visit",
        "schedule": null,
        "transition": null
      }
    },
    {
      "id": "visit_completed_summary",
      "steps": [
        {
          "when": null,
          "action": "send_email",
          "params": {
            "to": "patient.owner.email",
            "subject": "Visit summary for {patient.name}",
            "body": "{patient.name}'s visit is complete. Total due: {total}.\nNotes from the vet: {clinical_notes}"
          }
        }
      ],
      "trigger": {
        "type": "lifecycle.transition",
        "entity": "visit",
        "schedule": null,
        "transition": "complete_visit"
      }
    },
    {
      "id": "visit_reminder_daily",
      "steps": [
        {
          "when": "status == 'scheduled' and visit_date >= today() and visit_date < tomorrow()",
          "action": "send_email",
          "params": {
            "to": "patient.owner.email",
            "subject": "Reminder: {patient.name} is booked today",
            "body": "Hi {patient.owner.full_name}, a reminder that {patient.name} is booked in today at {visit_date}."
          }
        }
      ],
      "trigger": {
        "type": "schedule",
        "entity": "visit",
        "schedule": "0 8 * * *",
        "transition": null
      }
    },
    {
      "id": "vaccination_due_reminder",
      "steps": [
        {
          "when": "next_vaccination_due == today()",
          "action": "send_email",
          "params": {
            "to": "owner.email",
            "subject": "{name} is due for vaccination",
            "body": "Hi {owner.full_name}, {name} is due for vaccination today. Please book a visit."
          }
        }
      ],
      "trigger": {
        "type": "schedule",
        "entity": "patient",
        "schedule": "0 9 * * *",
        "transition": null
      }
    }
  ],
  "integrations": [],
  "requirements": [
    {
      "id": "R1",
      "text": "Register pet owners and their pets (species, breed, birth date, weight, microchip) with contact details",
      "priority": "must"
    },
    {
      "id": "R2",
      "text": "Book a visit for a pet with a reason, and see all visits on a calendar",
      "priority": "must"
    },
    {
      "id": "R3",
      "text": "Move each visit through scheduled, in progress, completed or cancelled; a visit cannot be completed without clinical notes",
      "priority": "must"
    },
    {
      "id": "R4",
      "text": "Record treatments given in a visit with quantity and price, and show the visit total automatically",
      "priority": "must"
    },
    {
      "id": "R5",
      "text": "Pet owners see and manage only their own pets and visits; vets and admins see everything",
      "priority": "must"
    },
    {
      "id": "R6",
      "text": "Email owners a booking confirmation, a same-day reminder and a completion summary with the total",
      "priority": "should"
    },
    {
      "id": "R7",
      "text": "Show a dashboard with today's visits, visits in progress, monthly revenue and vaccinations due, plus a vaccination reminder",
      "priority": "should"
    }
  ],
  "spec_version": "1.0"
}
