{
  "ui": {
    "nav": [
      {
        "icon": "home",
        "page": "dashboard",
        "label": "Dashboard",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ]
      },
      {
        "icon": "calendar",
        "page": "schedule",
        "label": "Schedule",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ]
      },
      {
        "icon": "stethoscope",
        "page": "visits",
        "label": "Visits",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ]
      },
      {
        "icon": "paw",
        "page": "patients",
        "label": "Patients",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ]
      },
      {
        "icon": "users",
        "page": "owners",
        "label": "Owners",
        "roles": [
          "admin",
          "vet"
        ]
      }
    ],
    "pages": [
      {
        "id": "dashboard",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ],
        "route": "/",
        "title": "Dashboard",
        "blocks": [
          {
            "id": "visit_stats",
            "type": "metric.stat",
            "props": {
              "entity": "visit",
              "items": [
                {
                  "label": "Visits today",
                  "agg": "count",
                  "where": "visit_date >= today() and visit_date < tomorrow()"
                },
                {
                  "label": "In progress",
                  "agg": "count",
                  "where": "status == 'in_progress'"
                },
                {
                  "label": "Revenue this month",
                  "agg": "sum",
                  "field": "total",
                  "where": "status == 'completed' and visit_date >= startOfMonth()"
                }
              ]
            }
          },
          {
            "id": "patient_stats",
            "type": "metric.stat",
            "props": {
              "entity": "patient",
              "items": [
                {
                  "label": "Patients",
                  "agg": "count"
                },
                {
                  "label": "Vaccinations due",
                  "agg": "count",
                  "where": "next_vaccination_due <= today()"
                }
              ]
            }
          },
          {
            "id": "visits_by_status",
            "type": "chart.bar",
            "props": {
              "entity": "visit",
              "title": "Visits by Status",
              "x": "status",
              "y": "count"
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "schedule",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ],
        "route": "/schedule",
        "title": "Schedule",
        "blocks": [
          {
            "id": "visit_calendar",
            "type": "calendar.month",
            "props": {
              "entity": "visit",
              "date_field": "visit_date",
              "row_link": "visit_detail"
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "owners",
        "roles": [
          "admin",
          "vet"
        ],
        "route": "/owners",
        "title": "Owners",
        "blocks": [
          {
            "id": "owner_filter",
            "type": "filter.bar",
            "props": {
              "entity": "owner",
              "fields": [],
              "search": [
                "full_name",
                "phone",
                "email"
              ]
            }
          },
          {
            "id": "owners_table",
            "type": "data.table",
            "props": {
              "entity": "owner",
              "columns": [
                "full_name",
                "phone",
                "email"
              ],
              "row_link": "owner_detail",
              "create": true
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "owner_detail",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ],
        "route": "/owners/:id",
        "title": "Owner",
        "blocks": [
          {
            "id": "owner_info",
            "type": "record.detail",
            "props": {
              "entity": "owner",
              "sections": [
                {
                  "title": "Contact",
                  "fields": [
                    "full_name",
                    "phone",
                    "email",
                    "address"
                  ]
                }
              ]
            }
          },
          {
            "id": "owner_pets",
            "type": "record.related_list",
            "props": {
              "entity": "patient",
              "via": "owner",
              "columns": [
                "name",
                "species",
                "breed",
                "next_vaccination_due"
              ],
              "row_link": "patient_detail",
              "create": true
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "patients",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ],
        "route": "/patients",
        "title": "Patients",
        "blocks": [
          {
            "id": "patient_filter",
            "type": "filter.bar",
            "props": {
              "entity": "patient",
              "fields": [
                "species"
              ],
              "search": [
                "name",
                "breed",
                "owner.full_name"
              ]
            }
          },
          {
            "id": "patients_table",
            "type": "data.table",
            "props": {
              "entity": "patient",
              "columns": [
                "name",
                "species",
                "breed",
                "owner.full_name",
                "weight_kg",
                "next_vaccination_due"
              ],
              "row_link": "patient_detail",
              "create": true
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "patient_detail",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ],
        "route": "/patients/:id",
        "title": "Patient",
        "blocks": [
          {
            "id": "patient_info",
            "type": "record.detail",
            "props": {
              "entity": "patient",
              "sections": [
                {
                  "title": "Profile",
                  "fields": [
                    "name",
                    "species",
                    "breed",
                    "birth_date",
                    "weight_kg"
                  ]
                },
                {
                  "title": "Care",
                  "fields": [
                    "owner",
                    "microchip_id",
                    "next_vaccination_due"
                  ]
                }
              ]
            }
          },
          {
            "id": "patient_visits",
            "type": "record.related_list",
            "props": {
              "entity": "visit",
              "via": "patient",
              "columns": [
                "visit_date",
                "reason",
                "status",
                "total"
              ],
              "row_link": "visit_detail",
              "create": true
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "visits",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ],
        "route": "/visits",
        "title": "Visits",
        "blocks": [
          {
            "id": "visit_filter",
            "type": "filter.bar",
            "props": {
              "entity": "visit",
              "fields": [
                "status"
              ],
              "search": [
                "reason",
                "patient.name"
              ]
            }
          },
          {
            "id": "visits_table",
            "type": "data.table",
            "props": {
              "entity": "visit",
              "columns": [
                "visit_date",
                "patient.name",
                "reason",
                "status",
                "total"
              ],
              "row_link": "visit_detail",
              "create": true
            }
          }
        ],
        "layout": "grid"
      },
      {
        "id": "visit_detail",
        "roles": [
          "admin",
          "vet",
          "pet_owner"
        ],
        "route": "/visits/:id",
        "title": "Visit",
        "blocks": [
          {
            "id": "visit_lifecycle",
            "type": "lifecycle.pipeline",
            "props": {
              "entity": "visit"
            }
          },
          {
            "id": "visit_info",
            "type": "record.detail",
            "props": {
              "entity": "visit",
              "sections": [
                {
                  "title": "Visit",
                  "fields": [
                    "visit_date",
                    "patient",
                    "reason",
                    "status"
                  ]
                },
                {
                  "title": "Clinical notes",
                  "fields": [
                    "clinical_notes"
                  ]
                },
                {
                  "title": "Billing",
                  "fields": [
                    "consultation_fee",
                    "total"
                  ]
                }
              ]
            }
          },
          {
            "id": "visit_treatments",
            "type": "record.related_list",
            "props": {
              "entity": "treatment",
              "via": "visit",
              "columns": [
                "name",
                "quantity",
                "unit_price",
                "line_total"
              ],
              "create": true
            }
          }
        ],
        "layout": "grid"
      }
    ],
    "theme": {
      "fonts": "Inter",
      "radius": "md",
      "density": "comfortable",
      "palette": "teal",
      "archetype": "calendar-centric"
    }
  },
