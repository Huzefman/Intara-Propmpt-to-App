   {
    "id": "dashboard",
    "roles": [
     "owner",
     "vet",
     "admin"
    ],
    "route": "/",
    "title": "Dashboard",
    "blocks": [
     {
      "id": "total_owners",
      "type": "metric.stat",
      "props": {
       "label": "Total Owners",
       "entity": "owner",
       "metric": "count"
      }
     },
     {
      "id": "total_patients",
      "type": "metric.stat",
      "props": {
       "label": "Total Patients",
       "entity": "patient",
       "metric": "count"
      }
     },
     {
      "id": "total_visits",
      "type": "metric.stat",
      "props": {
       "label": "Total Visits",
       "entity": "visit",
       "metric": "count"
      }
     },
     {
      "id": "visits_by_status",
      "type": "chart.bar",
      "props": {
       "x": "status",
       "y": "count",
       "title": "Visits by Status",
       "entity": "visit"
      }
     }
    ],
    "layout": "grid"
   },
   {
    "id": "owners",
    "roles": [
     "owner",
     "admin"
    ],
    "route": "/owners",
    "title": "Owners",
    "blocks": [
     {
      "id": "owners_table",
      "type": "data.table",
      "props": {
       "entity": "owner",
       "fields": [
        "full_name",
        "email",
        "phone",
        "address"
       ],
       "rowLink": "/owners/:id"
      }
     }
    ],
    "layout": "grid"
   },
   {
    "id": "owner_detail",
    "roles": [
     "owner",
     "admin"
    ],
    "route": "/owners/:id",
    "title": "Owner Detail",
    "blocks": [
     {
      "id": "owner_detail",
      "type": "record.detail",
      "props": {
       "entity": "owner",
       "fields": [
        "full_name",
        "email",
        "phone",
        "address"
       ]
      }
     },
     {
      "id": "owner_pets",
      "type": "record.related_list",
      "props": {
       "entity": "owner",
       "fields": [
        "name",
        "species",
        "breed",
        "birth_date",
        "weight_kg"
       ],
       "rowLink": "/patients/:id",
       "relation": "pets"
      }
     }
    ],
    "layout": "grid"
   },
   {
    "id": "patients",
    "roles": [
     "owner",
     "vet",
     "admin"
    ],
    "route": "/patients",
    "title": "Patients",
    "blocks": [
     {
      "id": "patients_table",
      "type": "data.table",
      "props": {
       "entity": "patient",
       "fields": [
        "name",
        "species",
        "breed",
        "birth_date",
        "weight_kg"
       ],
       "rowLink": "/patients/:id"
      }
     }
    ],
    "layout": "grid"
   },
   {
    "id": "patient_detail",
    "roles": [
     "owner",
     "vet",
     "admin"
    ],
    "route": "/patients/:id",
    "title": "Patient Detail",
    "blocks": [
     {
      "id": "patient_detail",
      "type": "record.detail",
      "props": {
       "entity": "patient",
       "fields": [
        "name",
        "species",
        "breed",
        "birth_date",
        "weight_kg"
       ]
      }
     },
     {
      "id": "patient_visits",
      "type": "record.related_list",
      "props": {
       "entity": "patient",
       "fields": [
        "visit_date",
        "reason",
        "status",
        "consultation_fee"
       ],
       "rowLink": "/visits/:id",
       "relation": "visits"
      }
     }
    ],
    "layout": "grid"
   },
   {
    "id": "visits",
    "roles": [
     "vet",
     "admin"
    ],
    "route": "/visits",
    "title": "Visits",
    "blocks": [
     {
      "id": "visits_table",
      "type": "data.table",
      "props": {
       "entity": "visit",
       "fields": [
        "visit_date",
        "patient_id",
        "reason",
        "status",
        "consultation_fee"
       ],
       "rowLink": "/visits/:id"
      }
     }
    ],
    "layout": "grid"
   },
   {
    "id": "visit_detail",
    "roles": [
     "vet",
     "admin"
    ],
    "route": "/visits/:id",
    "title": "Visit Detail",
    "blocks": [
     {
      "id": "visit_detail",
      "type": "record.detail",
      "props": {
       "entity": "visit",
       "fields": [
        "visit_date",
        "patient_id",
        "reason",
        "clinical_notes",
        "consultation_fee",
        "status"
       ]
      }
     },
     {
      "id": "visit_lifecycle",
      "type": "lifecycle.pipeline",
      "props": {
       "field": "status",
       "entity": "visit",
       "transitions": [
        "start_visit",
        "complete_visit",
        "cancel_visit"
       ]
      }
     }
    ],
    "layout": "grid"
   }
  ],
  "theme": {
   "fonts": "system",
   "radius": "md",
   "density": "comfortable",
   "palette": "light",
   "archetype": "default"
  }
