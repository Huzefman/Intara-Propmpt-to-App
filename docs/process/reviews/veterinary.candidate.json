   "steps": [
    {
     "when": null,
     "action": "send_email",
     "params": {
      "to": "{{patient.owner.email}}",
      "body": "The visit on {{visit.visit_date}} has been completed.\nClinical notes: {{visit.clinical_notes}}",
      "subject": "Visit completed for {{patient.name}}"
     }
    }
   ],
