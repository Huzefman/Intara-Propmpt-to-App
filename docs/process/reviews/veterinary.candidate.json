   }
  },
  {
   "id": "daily_visit_export",
   "steps": [
    {
     "when": null,
     "action": "export_csv",
     "params": {
      "entity": "visit",
      "fields": [
       "visit_date",
       "patient.name",
       "reason",
       "status",
       "consultation_fee"
      ],
      "filter": "visit_date >= today() AND visit_date < tomorrow()"
     }
    }
   ],
   "trigger": {
    "type": "schedule",
    "entity": null,
    "schedule": "0 8 * * *",
    "transition": null
   }
  }
 ],
